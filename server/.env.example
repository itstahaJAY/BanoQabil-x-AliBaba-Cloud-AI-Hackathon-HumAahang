# Copy to .env in this server folder, then replace placeholders privately.
# Never commit .env or put provider keys/operator token into EXPO_PUBLIC_*.
STT_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_key
OPENAI_STT_MODEL=gpt-4o-transcribe
# Optional explicit rollback only: STT_PROVIDER=deepgram requires this key.
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=replace_with_deepseek_key
STT_CLIENT_TOKEN=replace_with_random_token_at_least_32_characters
STT_PORT=8787
STT_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DEEPSEEK_MODEL=deepseek-v4-flash

# Photo analysis and static hand-pose practice use the same key, a separate model.
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional private judge invitation, public deployment only. Leave BOTH blank to disable.
# Generate a separate random 32-byte base64url key (43 characters); never reuse any key above.
# Use a future UTC ISO deadline such as 2099-01-01T00:00:00.000Z, with your actual short deadline.
# Share only privately in a URL fragment. Never commit, log or bundle the invitation.
JUDGE_ACCESS_KEY=
JUDGE_ACCESS_EXPIRES_AT=
# Grants last at most one hour or the invitation deadline, whichever comes first.
# All judge grants share per-process budgets: 30 grants, 30 speech reservations,
# 60 combined vision analysis/translation requests. Reconnect does not reset them.
# One replica only. Restart resets counters; these are NOT a dollar spending cap.
